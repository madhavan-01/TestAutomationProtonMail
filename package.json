{
  "name": "proton-mail-qa-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress (JavaScript) regression suite for Proton Mail Web",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run --browser chrome",
    "cy:smoke": "cypress run --browser chrome --env grepTags=@smoke",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:spec": "cypress run --browser chrome --spec",
    "lint:syntax": "node scripts/check-syntax.js"
  },
  "devDependencies": {
    "@cypress/grep": "^4.1.0",
    "cypress": "^13.15.0",
    "cypress-mochawesome-reporter": "^3.8.2"
  }
}
